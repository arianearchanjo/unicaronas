# ==============================================================================
# UniCaronas — .env.example (Sprints 1 a 8)
# Este arquivo serve como template para as configurações do ambiente.
# Crie uma cópia como ".env" e preencha com os valores reais.
# ==============================================================================

# ── CONFIGURAÇÕES GLOBAIS E SERVIDOR ──────────────────────────────────────────
# Porta onde a API será executada
PORT=3000

# Ambiente de execução: development ou production
# Em production: logs comuns são suprimidos e o CORS é restringido.
NODE_ENV=development

# ── BANCO DE DADOS (PostgreSQL) ───────────────────────────────────────────────
# URL de conexão completa (recomendado para Cloud/Docker)
# Exemplo local: postgresql://postgres:senha@localhost:5432/unicaronas
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Campos individuais (Opcional, usado se DATABASE_URL não for fornecido)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unicaronas
DB_USER=postgres
DB_PASSWORD=sua_senha_secreta

# ── AUTENTICAÇÃO E SEGURANÇA ──────────────────────────────────────────────────
# Chave secreta para assinatura dos tokens JWT.
# Recomendação: Mínimo 32 caracteres aleatórios.
JWT_SECRET=sua_chave_mestra_super_secreta_com_muitos_caracteres_123

# ── INTEGRAÇÃO DE PAGAMENTOS (PIX) ───────────────────────────────────────────
# Dados para geração do QR Code PIX estático
PIX_CHAVE=financeiro@unicaronas.com.br
PIX_NOME=UniCaronas LTDA
PIX_CIDADE=Curitiba

# ── SERVIÇO DE E-MAIL (SMTP com Nodemailer) ──────────────────────────────────
# Servidor SMTP (Ex: smtp.gmail.com, smtp.mailtrap.io)
SMTP_HOST=smtp.gmail.com

# Porta do servidor (587 para TLS ou 465 para SSL)
SMTP_PORT=587

# Credenciais de acesso
SMTP_USER=seu_email@exemplo.com
SMTP_PASS=sua_senha_de_aplicativo_ou_token

# E-mail que aparecerá como remetente
EMAIL_FROM="UniCaronas <nao-responda@unicaronas.com.br>"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=nao-responda@unicaronas.com.br
MAIL_PASS=XXXXXXXXXXXXXXXX
# ── CONFIGURAÇÃO DE ORIGEM E CORS ─────────────────────────────────────────────
# URL real do seu Frontend para restringir o acesso em produção
# Local comum (Live Server): http://127.0.0.1:5500
# Produção: https://seuapp.vercel.app
FRONTEND_URL=http://localhost:5500

# ── REGRAS DE NEGÓCIO E VALIDAÇÃO ─────────────────────────────────────────────
# Domínios permitidos para cadastro de usuários (separar por vírgula)
EMAIL_DOMINIOS=@unibrasil.com.br,@docente.unibrasil.com.br

# Valores base para o motor de precificação sugerida
GAS_PRICE=7.19
KM_PER_LITER=10
TAXA_PLATAFORMA_PERCENT=10
